AIRFLOW__DAG_PROCESSOR__DAG_IMPORTER_CONFIGS=[{"classpath":"airflow.sdk.importers.yaml_importer.YamlDagImporter"}]

AIRFLOW_CONN_PYDANTICAI_DEFAULT='{
    "conn_type":"pydanticai",
    "password":"<your key>",
    "extra":{
        "model":"openai:gpt-4o"
    }
}'

AIRFLOW_CONN_DECISION_DEFAULT='{
    "conn_type":"pydanticai",
    "password":"<your key>",
    "extra":{
        "model":"openai-decisions:gpt-6-luna"
    }
}'

AIRFLOW_CONN_GIT_DEFAULT='{
    "conn_type":"git",
    "host":"https://github.com/TJaniF/dag-bundle-test.git"
}'

AIRFLOW__SDK__QUEUE_TO_COORDINATOR='{"golang": "go", "java": "java", "typescript": "ts"}'

AIRFLOW__SDK__COORDINATORS='{
    "go": {"classpath": "airflow.sdk.coordinators.executable.ExecutableCoordinator"},
    "java": {"classpath": "airflow.sdk.coordinators.java.JavaCoordinator"},
    "ts": {"classpath": "airflow.sdk.coordinators.node.NodeCoordinator"}
}'

# AIRFLOW__CORE__XCOM_BACKEND=include.custom_xcom_backend.MyCustomXComBackend

AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST='[
    {
        "name": "dags-folder",
        "classpath": "airflow.dag_processing.bundles.local.LocalDagBundle",
        "kwargs": {}
    },
    {
        "name": "dag-bundle-test",
        "classpath": "airflow.providers.git.bundles.git.GitDagBundle",
        "kwargs": {
            "repo_url": "https://github.com/TJaniF/dag-bundle-test.git",
            "tracking_ref": "main",
            "subdir": "",
            "refresh_interval": 60
        }
    }
]'
