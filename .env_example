OPENAI_API_KEY="<your OpenAI API key>"

AIRFLOW_CONN_PYDANTICAI_DEFAULT='{
    "conn_type":"pydanticai",
    "password":"<your OpenAI API key>",
    "extra":{
        "model":"openai:gpt-4o"
    }
}'

AIRFLOW_CONN_KAFKA_DEFAULT='{
  "conn_type":"general",
  "extra": {
    "bootstrap.servers":"kafka:19092",
    "group.id":"group_1",
    "security.protocol":"PLAINTEXT",
    "enable.auto.commit":false,
    "auto.offset.reset":"beginning"
  }
}'

SPARK_CONN_ID="spark_default"
SPARK_DATABASE="<your-database>"
SPARK_SCHEMA="<your-schema>"
AIRFLOW_CONN_SPARK_DEFAULT='{
    "conn_type":"spark_connect",
    "host":"sc://spark-connect",
    "port":15002
}'

AIRFLOW_CONN_SPARK_STANDALONE='{
    "conn_type":"spark",
    "host":"spark://spark-master",
    "port":7077,
    "extra":{
        "deploy-mode":"cluster"
    }
}'

AIRFLOW_CONN_SSH_DEFAULT='{
    "conn_type":"ssh",
    "host":"ssh-target",
    "login":"airflow",
    "password":"airflow",
    "port":2222,
    "extra":{
        "no_host_key_check":true
    }
}'

AIRFLOW_CONN_GIT_DEFAULT='{
    "conn_type": "git",
    "host": "https://github.com/<account>/<repo>", 
    "password": "github_pat_<your-token>" 
}'

# Config to use 1 LocalDagBundle plus 1 GitDagBundle
AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST='[
    {
        "name": "local-dags-folder",
        "classpath": "airflow.dag_processing.bundles.local.LocalDagBundle",
        "kwargs": {}
    },
    {
        "name": "my-favorite-git-bundle",
        "classpath": "airflow.providers.git.bundles.git.GitDagBundle",
        "kwargs": {
            "git_conn_id": "git_default",
            "subdir": "dags", 
            "tracking_ref": "main",
            "refresh_interval": 10
        }
    }
]'

AIRFLOW__STATE_STORE__DEFAULT_RETENTION_DAYS=5

# Go SDK: route the "golang" queue to the ExecutableCoordinator, which runs the
# compiled Go bundle in include/go_bundle/bin (mounted at /usr/local/airflow/include).
# Java SDK: route the "java" queue to the JavaCoordinator, which runs the bundled
# jar in include/java_bundle (mounted at /usr/local/airflow/include). "java" needs
# to be on PATH in the workers (provided by openjdk-21-jre-headless in packages.txt).
AIRFLOW__SDK__QUEUE_TO_COORDINATOR='{"golang": "go", "java": "java"}'

AIRFLOW__SDK__COORDINATORS='{
    "go": {
        "classpath": "airflow.sdk.coordinators.executable.ExecutableCoordinator",
        "kwargs": {
            "executables_root": ["/usr/local/airflow/include/go_bundle/bin"]
        }
    },
    "java": {
        "classpath": "airflow.sdk.coordinators.java.JavaCoordinator",
        "kwargs": {
            "jars_root": ["/usr/local/airflow/include/java_bundle"]
        }
    }
}'